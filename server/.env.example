# Copia este archivo como .env y ajusta los valores.
# Nunca subir .env al repositorio.
DATABASE_URL=postgresql://user:password@host:5432/accountant
TEST_DATABASE_URL=postgresql://user:password@host:5432/accountant_test
PORT=3001
LOG_LEVEL=info
# Cifrado de credenciales de integraciones (AES-256-GCM, 32 bytes).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=
# Versión de la clave vigente (para rotar: nueva clave + SECRETS_MASTER_KEY_V<n> con la anterior)
SECRETS_KEY_VERSION=1

# Autenticación (sesión por cookie httpOnly + CSRF).
# Orígenes permitidos con credenciales (coma separada; '*' refleja cualquiera).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Ponlo en true detrás de HTTPS.
COOKIE_SECURE=false
